    "content": "<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match day:\n    case 1:\n        print(\"Monday\")\n    case 2:\n        print(\"Tuesday\")\n    case 3:\n        print(\"Wednesday\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match colour:\n    case \"red\":\n        print(\"You chose red\")\n    case \"blue\":\n        print(\"You chose blue\")\n    case \"green\":\n        print(\"You chose green\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match command:\n    case \"start\":\n        print(\"Starting program\")\n    case \"stop\":\n        print(\"Stopping program\")\n    case \"restart\":\n        print(\"Restarting program\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match day:\n    case 1:\n        print(\"Monday\")\n    case 2:\n        print(\"Tuesday\")\n    case _:\n        print(\"Invalid day\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match day:\n    case \"Saturday\" | \"Sunday\":\n        print(\"Weekend\")\n    case _:\n        print(\"Weekday\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match number:\n    case 1:\n        print(\"One\")\n    case 2:\n        print(\"Two\")\n    case 3:\n        print(\"Three\")\n    case _:\n        print(\"Another number\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match age:\n    case age if age &lt; 13:\n        print(\"Child\")\n    case age if age &lt; 18:\n        print(\"Teenager\")\n    case _:\n        print(\"Adult\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match items:\n    case [1, 2]:\n        print(\"The list contains 1 and 2\")\n    case [1, 2, 3]:\n        print(\"The list contains 1, 2 and 3\")\n    case _:\n        print(\"Something else\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match point:\n    case (x, y):\n        print(\"X:\", x)\n        print(\"Y:\", y)</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>if command == \"start\":\n    print(\"Starting\")\nelif command == \"stop\":\n    print(\"Stopping\")\nelse:\n    print(\"Unknown command\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match command:\n    case \"start\":\n        print(\"Starting\")\n    case \"stop\":\n        print(\"Stopping\")\n    case _:\n        print(\"Unknown command\")</code></pre>\n</div>\n\n<div class=\"bg-slate-900 text-slate-100 p-4 rounded-xl relative my-3\">\n  <button onclick=\"copyCode(this)\" class=\"absolute top-2.5 right-2.5 px-2 py-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700\"><i class=\"fa-regular fa-copy\"></i> Copy</button>\n  <pre><code>match operator:\n    case \"+\":\n        print(a + b)\n    case \"-\":\n        print(a - b)\n    case \"*\":\n        print(a * b)\n    case \"/\":\n        print(a / b)\n    case _:\n        print(\"Invalid operator\")</code></pre>\n</div>\n"
